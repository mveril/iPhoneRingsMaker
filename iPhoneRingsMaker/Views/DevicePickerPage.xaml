<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="iPhoneRingsMaker.Views.DevicePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iPhoneRingsMaker.Models"
    x:Uid="DevicePicker"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanTransfer, Mode=OneWay}"
    MaxWidth="760"
    MinWidth="720"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinHeight="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing
                AutomationProperties.AutomationId="DeviceLoadingIndicator"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                x:Uid="DevicePicker_Loading"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <ListView
            x:Name="DeviceList"
            Grid.Row="1"
            MinHeight="220"
            MaxHeight="300"
            AutomationProperties.AutomationId="AppleDeviceList"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Devices}"
            SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AppleDeviceInfo">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EA;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <InfoBar
                x:Name="ConnectionHelpInfoBar"
                x:Uid="DevicePicker_ConnectionHelp"
                AutomationProperties.AutomationId="DeviceConnectionHelpInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <HyperlinkButton
                        x:Uid="DevicePicker_AppleHelp"
                        NavigateUri="https://support.apple.com/108643?device-type=windows-pc" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <TeachingTip
            x:Name="ConnectionTeachingTip"
            x:Uid="DevicePicker_ConnectionTip"
            IsLightDismissEnabled="True"
            IsOpen="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}"
            PreferredPlacement="Top"
            Target="{x:Bind ConnectionHelpInfoBar}">
            <TeachingTip.IconSource>
                <SymbolIconSource Symbol="Help" />
            </TeachingTip.IconSource>
        </TeachingTip>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="DeviceStatusInfoBar"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}" />
    </Grid>
</ContentDialog>
