<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="iPhoneRingsMaker.Views.IPhoneMusicPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iPhoneRingsMaker.Models"
    x:Uid="MusicLibraryPicker"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanUseSelection, Mode=OneWay}"
    MaxWidth="760"
    MinWidth="720"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <Grid MinHeight="440" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox
            x:Name="DeviceSelector"
            x:Uid="MusicLibrary_Device"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="MusicLibraryDeviceSelector"
            DisplayMemberPath="Name"
            ItemsSource="{x:Bind ViewModel.Devices}"
            SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" />

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            x:Uid="MusicLibrary_Search"
            AutomationProperties.AutomationId="MusicLibrarySearchBox"
            IsEnabled="{x:Bind ViewModel.IsSearchEnabled, Mode=OneWay}"
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            x:Name="TrackList"
            Grid.Row="2"
            AutomationProperties.AutomationId="MusicLibraryTrackList"
            ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedTrack, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IPhoneMusicTrackItem">
                    <Grid Padding="8" ColumnSpacing="12" Opacity="{x:Bind Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="48" Height="48" VerticalAlignment="Center">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE8D6;" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Artist}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Album}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind AvailabilityDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="MusicLibraryLoadingOverlay"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    x:Uid="MusicLibrary_Loading"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <InfoBar
                x:Uid="MusicLibrary_ConnectionHelp"
                AutomationProperties.AutomationId="MusicLibraryConnectionHelpInfoBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <HyperlinkButton
                        x:Uid="DevicePicker_AppleHelp"
                        NavigateUri="https://support.apple.com/108643?device-type=windows-pc" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="3"
            AutomationProperties.AutomationId="MusicLibraryStatusInfoBar"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}" />
    </Grid>
</ContentDialog>
